# --- Database (shared with Person A/C — same Postgres instance) -------------
DATABASE_URL="postgresql://user:password@localhost:5432/swans_hackathon"

# --- AI provider -------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"

# --- Pipeline behavior ---------------------------------------------------
# Caps how many NEW/CHANGED source records get sent to the model per digest
# run, so a first-ever run on a huge matter doesn't blow the time/cost budget.
# Oldest-first backfill continues on the next run.
AI_MAX_RECORDS_PER_RUN=120

# If true, skips real Gemini calls and uses the deterministic stub responses
# in src/lib/ai/stub.ts — useful for Person C to integrate against before the
# real API key exists, and for CI.
AI_USE_STUB=false
